# Copy to .env and fill in only when you want a live provider.
# The mock demo does not need this file. Empty values stay in mock mode.
# Every value here is a placeholder. Do not put a real key in this example file.
#
#   cp .env.example .env
#
# The bench CLI reads .env and does not override variables already exported.
# npm run demo forces --mode mock, so it never calls a paid API.

# auto | mock | live. mock ignores keys and uses the recorded stand-ins.
MODEL_BENCH_MODE=mock

# Live judge. Leave the key empty to keep the recorded judge.
# A non-empty JUDGE_API_KEY makes --judge auto call the network.
JUDGE_PROVIDER=openai-compatible
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_MODEL=your-judge-model
JUDGE_INPUT_USD_PER_MTOK=0
JUDGE_OUTPUT_USD_PER_MTOK=0

# Demo stand-ins. Leave these empty. Cedar Pro, Cedar Flash, Inkwell, and
# Surveyor are fictional recorded fixtures, not hosted models.
CEDAR_PRO_API_KEY=
CEDAR_PRO_BASE_URL=https://api.example.com/v1
CEDAR_FLASH_API_KEY=
CEDAR_FLASH_BASE_URL=https://api.example.com/v1
INKWELL_API_KEY=
INKWELL_BASE_URL=https://api.example.com/v1
SURVEYOR_API_KEY=
SURVEYOR_BASE_URL=https://api.example.com/v1

# Your model, matching the commented block in models.yaml.
# YOUR_MODEL_API_KEY=sk-replace-me
# YOUR_MODEL_BASE_URL=https://api.example.com/v1
